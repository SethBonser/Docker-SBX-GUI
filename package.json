{
  "name": "docker-sandbox-gui",
  "version": "0.1.0",
  "description": "A desktop GUI for Docker Sandboxes (sbx) — create, run, and chat with AI coding agent sandboxes without touching a terminal.",
  "main": "./out/main/index.js",
  "author": "Seth Bonser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "postinstall": "patch-package && node node_modules/electron/install.js && electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@electron-toolkit/utils": "3.0.0",
    "@tanstack/react-query": "5.101.4",
    "electron-store": "10.1.0",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "6.30.4",
    "remark-gfm": "4.0.1",
    "zod": "3.25.76",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "1.0.1",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.4",
    "electron": "43.3.0",
    "electron-builder": "26.15.7",
    "electron-vite": "5.0.0",
    "patch-package": "8.0.1",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.12",
    "browserslist": "4.28.7",
    "electron-to-chromium": "1.5.402",
    "esbuild": "0.28.1",
    "ip-address": "10.4.0",
    "update-browserslist-db": "1.3.0"
  }
}
